# Notion Janitor environment example

# Ultimate Brain / Notion
NOTION_TOKEN=ntn_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notes_database_id_here

# Pi Web UI Internal API summarisation
# Pi Web UI must be running and authenticated for the local socket/token defaults.
# The summariser uses only openai-codex/gpt-5.6-luna at medium thinking.
PI_INTERNAL_API_SOCKET_PATH=/root/.pi-web-ui/internal-api.sock
PI_INTERNAL_API_TOKEN_PATH=/root/.pi-web-ui/internal-api-token
PI_SUMMARISER_CWD=/root/notionjanitor/.runtime/summariser
PI_INTERNAL_API_REQUEST_TIMEOUT_SECONDS=30
PI_INTERNAL_API_MAX_WAIT_SECONDS=300
PI_INTERNAL_API_POLL_INTERVAL_SECONDS=1
PI_SUMMARISER_MAX_CONTENT_CHARS=120000

# Telegram review surface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# Scanner behaviour
CUTOFF_DAYS=60
# Per-type cap: applied separately to project-linked notes and orphan notes (total = STALE_NOTE_LIMIT * 2).
STALE_NOTE_LIMIT=13
SCHEDULE_DAY=mon
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Local state / logging
STATE_DB_PATH=data/janitor.db
LOG_FILE=/var/log/notion-janitor.log
